# Copy to `.env` and fill in. `.env` is gitignored: never commit real keys.
# Existing environment variables take precedence over values in `.env`.

# --- LLM provider (vka.agent.providers; README: Agent > Providers) ---
# Any OpenAI-compatible endpoint:
#   vLLM   (`vllm serve <model>`): http://localhost:8000/v1
#   Ollama:                        http://localhost:11434/v1
#   Hosted API:                    the provider's OpenAI-compatible base URL
VKA_BASE_URL=http://localhost:11434/v1
# Local servers usually ignore the key; hosted APIs require one.
VKA_API_KEY=
VKA_MODEL=

# --- Optional overrides ---
# Path to the kharness binary used by vka.agent.tools.
# VKA_KHARNESS_BIN=harness/target/release/kharness
